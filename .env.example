# Copie para .env.local só se for testar localmente com `vercel dev`.
# Na Vercel, cadastre estas variáveis em Settings > Environment Variables.

# Senha que o dono do restaurante digita para entrar no painel
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Texto longo e aleatório (40+ caracteres). Só o servidor conhece; protege a sessão.
ADMIN_SECRET=troque-por-um-texto-aleatorio-bem-longo

# As variáveis abaixo são criadas AUTOMATICAMENTE ao conectar o Upstash Redis e o Blob ao projeto:
# UPSTASH_REDIS_REST_URL (ou KV_REST_API_URL)
# UPSTASH_REDIS_REST_TOKEN (ou KV_REST_API_TOKEN)
# BLOB_READ_WRITE_TOKEN
